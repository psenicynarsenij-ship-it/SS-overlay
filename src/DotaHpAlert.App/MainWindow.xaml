<Window x:Class="DotaHpAlert.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SS Overlay" Background="#11131D" Foreground="#F5F5FA" FontFamily="Segoe UI" FontSize="14" Width="1120" Height="850" MinWidth="720" MinHeight="600" Closing="WindowClosing">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/FluentDark.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
<DockPanel Margin="0,0,0,24"><Button DockPanel.Dock="Right" x:Name="SaveButton" Content="Сохранить настройки" Click="Save"/><Border DockPanel.Dock="Left" Background="#B7B9FF" CornerRadius="12" Padding="12" Margin="0,0,14,0"><TextBlock Text="SS" FontWeight="Bold" Foreground="#11131D" FontSize="24"/></Border><StackPanel><TextBlock Text="SS Overlay" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Dota HP Alert" Style="{StaticResource Secondary}"/></StackPanel></DockPanel>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Мониторинг" Style="{StaticResource Heading}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CurrentHp" Text="— HP" FontSize="46" FontWeight="SemiBold" Foreground="#B7B9FF"/><TextBlock x:Name="RecognitionConfidence" Text="Уверенность OCR: —" Style="{StaticResource Secondary}"/><TextBlock x:Name="Status" Text="Мониторинг остановлен" Foreground="#52D6A4"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="GameState" Text="Окно игры: ещё не проверено" Style="{StaticResource Secondary}"/><TextBlock x:Name="LastAlert" Text="Последнее предупреждение: —"/><Button x:Name="StartButton" Content="Начать мониторинг" Click="StartCapture" Background="#454365"/><Button x:Name="StopButton" Visibility="Collapsed" Content="Остановить" Click="Stop"/></StackPanel></Grid></StackPanel></Border>
<TabControl x:Name="Sections" Background="Transparent" BorderThickness="0"><TabItem Header="Предупреждения"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Предупреждения" Style="{StaticResource Heading}"/><WrapPanel><CheckBox x:Name="Invoker" Content="Профиль Invoker" Checked="InvokerChanged" Unchecked="InvokerChanged"/><CheckBox x:Name="Visual" Content="Визуальное уведомление"/><CheckBox x:Name="Sound" Content="Звук"/></WrapPanel><Grid x:Name="AlertFields"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Порог HP"/><TextBox x:Name="Threshold"/><Slider Minimum="1" Maximum="2000" Value="{Binding Text, ElementName=Threshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="1" IsSnapToTickEnabled="True"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Повтор, секунды"/><TextBox x:Name="Repeat"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Гистерезис, HP"/><TextBox x:Name="Hysteresis"/></StackPanel></Grid></StackPanel></Border>
</TabItem><TabItem Header="Оверлей"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Оверлей" Style="{StaticResource Heading}"/><TextBlock Text="Предпросмотр внешнего вида · пример HP" Style="{StaticResource Secondary}"/><Border Width="310" Background="#171B2A" CornerRadius="16" BorderBrush="#FF626F" BorderThickness="1" Padding="16"><StackPanel><TextBlock Text="☀" Foreground="#FFB879" FontSize="22" TextAlignment="Center"/><TextBlock Text="SUN STRIKE" Foreground="#B7B9FF" TextAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="150 HP" TextAlignment="Center" FontSize="40" FontWeight="Bold"/></StackPanel></Border><WrapPanel x:Name="PositionPanel" Margin="0,12,0,0"><Button Content="Сверху слева" Click="PositionTopLeft"/><Button Content="Сверху по центру" Click="PositionTopCenter"/><Button Content="Пользовательская" Click="PositionCustom"/><StackPanel><TextBlock Text="X, DIP"/><TextBox x:Name="OverlayX" Width="95"/></StackPanel><StackPanel><TextBlock Text="Y, DIP"/><TextBox x:Name="OverlayY" Width="95"/></StackPanel></WrapPanel><CheckBox x:Name="AnimationEnabled" Content="Мягкое появление (с учётом системной анимации)"/><Button Content="Тест уведомления" Click="TestNotification" HorizontalAlignment="Left"/></StackPanel></Border>
</TabItem><TabItem Header="Звук"><Border Style="{StaticResource Card}"><StackPanel x:Name="SoundPanel"><TextBlock Text="Звук" Style="{StaticResource Heading}"/><TextBlock x:Name="SoundName" Text="Стандартный сигнал" Style="{StaticResource Secondary}"/><ListBox x:Name="Presets" SelectionChanged="PresetChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="400">
<ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#F5F5FA"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="#171B2A" BorderBrush="#454B66" BorderThickness="1" CornerRadius="12" Padding="14" Margin="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#35374F"/><Setter TargetName="Surface" Property="BorderBrush" Value="#B7B9FF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#D0C8FF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#D0C8FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding FileName}" Foreground="#A1A5B8" FontSize="12"/><TextBlock Text="✓ Основной звук" Foreground="#B7B9FF"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><Button Grid.Column="1" Content="▶" ToolTip="Прослушать" Tag="{Binding}" Click="PreviewPreset"/><Button Grid.Column="2" Content="Выбрать" Tag="{Binding}" Click="SelectPreset"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Громкость"/><Slider x:Name="SoundVolume" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"/><TextBlock Text="{Binding Value, ElementName=SoundVolume, StringFormat=P0}" Foreground="#B7B9FF"/></StackPanel></Border>
</TabItem><TabItem Header="Дополнительно"><Border Style="{StaticResource Card}"><Expander Header="Дополнительно · Capture / OCR"><StackPanel><StackPanel x:Name="SettingsPanel"><TextBlock Text="Заголовок окна игры"/><TextBox x:Name="GameTitle"/><TextBlock Text="ROI: X / Y / ширина / высота, физические пиксели клиента"/><UniformGrid Columns="4"><TextBox x:Name="RegionX"/><TextBox x:Name="RegionY"/><TextBox x:Name="RegionWidth"/><TextBox x:Name="RegionHeight"/></UniformGrid><TextBlock Text="Минимальная уверенность (0–1)"/><TextBox x:Name="Confidence"/><TextBlock Text="Интервал захвата, мс (100–10000)"/><TextBox x:Name="Interval"/></StackPanel><WrapPanel><Button x:Name="ImageButton" Content="OCR изображения…" Click="OpenImage"/><Button x:Name="DemoButton" Content="Демо без Dota" Click="StartDemo"/></WrapPanel><TextBlock x:Name="Timing" Style="{StaticResource Secondary}"/><Border Height="100" Background="#171B2A" CornerRadius="10"><Image x:Name="Preview" Stretch="Uniform"/></Border><Expander Header="Диагностика / журнал"><TextBox x:Name="Diagnostics" Height="180" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Expander></StackPanel></Expander></Border>
</TabItem></TabControl></StackPanel></ScrollViewer></Window>
