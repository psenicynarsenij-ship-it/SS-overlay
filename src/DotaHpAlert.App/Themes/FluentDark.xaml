<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<SolidColorBrush x:Key="CardBrush" Color="#222638"/>
<SolidColorBrush x:Key="AccentBrush" Color="#B7B9FF"/>
<Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="#11131D"/><Setter Property="Foreground" Value="#F5F5FA"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F5F5FA"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style x:Key="Secondary" TargetType="TextBlock"><Setter Property="Foreground" Value="#A1A5B8"/><Setter Property="Margin" Value="0,6,0,8"/></Style>
<Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#2B3045"/><Setter Property="Foreground" Value="#F5F5FA"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderBrush="#454B66" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#45405F"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#565174"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#D0C8FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#171B2A"/><Setter Property="Foreground" Value="#F5F5FA"/><Setter Property="CaretBrush" Value="#B7B9FF"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,8,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="#454B66" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#B7B9FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F5F5FA"/><Setter Property="Margin" Value="0,8,12,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="Slider"><Setter Property="Margin" Value="0,8,12,12"/><Setter Property="Foreground" Value="#B7B9FF"/></Style>
<Style TargetType="Expander"><Setter Property="Foreground" Value="#F5F5FA"/><Setter Property="Margin" Value="0,8,0,12"/></Style>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="#F5F5FA"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" CornerRadius="10,10,0,0" Background="#222638" Margin="0,0,6,8" Padding="16,12"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#454365"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#D0C8FF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="Background" Value="#565174"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
